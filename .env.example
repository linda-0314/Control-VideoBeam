# Plantilla de variables de entorno de Control VideoBeam FET.
# Copia este archivo como .env y llena los valores. El archivo .env NO se sube a Git.

# Clave secreta de Django (ADR-001). Genera una propia; nunca la escribas en el código.
DJANGO_SECRET_KEY=

# True solo en el computador de desarrollo; False en el computador de la biblioteca.
DJANGO_DEBUG=False
